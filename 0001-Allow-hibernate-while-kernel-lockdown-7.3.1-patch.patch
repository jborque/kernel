From 7d5723ab232b2942390e4a9e084418264d33e279 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jer=C3=B3nimo=20Borque?= <jeronimo@borque.com.ar>
Date: Sun, 8 Nov 2026 02:30:35 -0300
Subject: [PATCH] Allow hibernate while kernel lockdown (7.3.1 patch)

---
 kernel/power/hibernate.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/kernel/power/hibernate.c b/kernel/power/hibernate.c
index c13f68ab7..d1ed36d8d 100644
--- a/kernel/power/hibernate.c
+++ b/kernel/power/hibernate.c
@@ -31,7 +31,6 @@
 #include <linux/syscore_ops.h>
 #include <linux/ctype.h>
 #include <linux/ktime.h>
-#include <linux/security.h>
 #include <linux/secretmem.h>
 #include <trace/events/power.h>
 
@@ -109,7 +108,6 @@ bool hibernation_in_progress(void)
 bool hibernation_available(void)
 {
 	return nohibernate == 0 &&
-		!security_locked_down(LOCKDOWN_HIBERNATION) &&
 		!secretmem_active() && !cxl_mem_active();
 }
 
